# API runtime (jenga_app: NOBYPASSRLS, non-owner — see db/bootstrap.sql)
APP_DB_URL=postgres://jenga_app:app_dev_pw@localhost:5432/jenga_dev
# Migration runner only (schema owner)
ADMIN_DB_URL=postgres://jenga_migrator:migrator_dev_pw@localhost:5432/jenga_dev
# Required in production, >=32 chars
JWT_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
PORT=3000
WORKER_DB_URL=postgres://jenga_worker:worker_dev_pw@localhost:5432/jenga_dev
FISCAL_WORKER_ENABLED=false
# Production providers (default: sandbox). Activate when Phase-0 credentials exist.
PAYMENT_PROVIDER=sandbox            # sandbox | daraja
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_STK_CALLBACK_URL=
FISCAL_PROVIDER=sandbox             # sandbox | oscu
OSCU_BASE_URL=
OSCU_TIN=
OSCU_BHF_ID=00
OSCU_CMC_KEY=
