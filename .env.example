# API runtime (jenga_app: NOBYPASSRLS, non-owner — see db/bootstrap.sql)
APP_DB_URL=postgres://jenga_app:app_dev_pw@localhost:5432/jenga_dev
# Migration runner only (schema owner)
ADMIN_DB_URL=postgres://jenga_migrator:migrator_dev_pw@localhost:5432/jenga_dev
# Required in production, >=32 chars
JWT_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
PORT=3000
WORKER_DB_URL=postgres://jenga_worker:worker_dev_pw@localhost:5432/jenga_dev
FISCAL_WORKER_ENABLED=false
